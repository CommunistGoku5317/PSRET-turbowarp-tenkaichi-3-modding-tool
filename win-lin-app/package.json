{
  "name": "bt3-desktop-modder",
  "version": "0.1.0",
  "description": "AFS / AFL / Spike PAK Explorer, Rebuilder & QRS 4/8-bit Texture Decoder",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.bt3modder.desktop",
    "productName": "BT3 Desktop Modder",
    "icon": "icon.png",
    "files": [
      "**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
